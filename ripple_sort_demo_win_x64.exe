constexpr const char* VERSION = "v2.1.1 Adaptive";

constexpr int INSERTION_SORT_THRESHOLD = 64;
constexpr int NINTHER_THRESHOLD = 128;
constexpr int MAX_NEARLY_SORTED_INVERSION = 4;
constexpr int NEARLY_SORTED_SAMPLE = 8;
constexpr int PRESCAN_THRESHOLD = 128;
constexpr int PARTIAL_INSERTION_LIMIT = 8;
constexpr int RADIX_SORT_THRESHOLD = 256;
constexpr int SORT_NETWORK_THRESHOLD = 5;
constexpr int BLOCK_SIZE = 64;

struct SortStats
{
    size_t count_partition{ 0 };
    size_t count_insertion{ 0 };
    size_t count_heap_fallback{ 0 };
    size_t count_heap_select{ 0 };
    size_t count_bad_partitions{ 0 };
    size_t count_radix_sort{ 0 };
    size_t count_block_partition{ 0 };
    size_t count_runs_detected{ 0 };
    bool hit_full_sorted{ false };
    bool hit_full_reverse{ false };
    bool hit_nearly_sorted{ false };
    bool hit_all_equal{ false };
    bool used_partial_sort{ false };
    bool used_radix_sort{ false };
    bool used_sort_network{ false };
    bool used_block_partition{ false };
    bool used_run_merge{ false };
    bool topk_truncated{ false };
    bool hit_nan_handled{ false };

    void print() const
    {
        std::cout << "\n\n-------- Sort Runtime Stats --------\n";
        std::cout << "hit_full_sorted:    " << std::boolalpha << hit_full_sorted << "\n";
        std::cout << "hit_full_reverse:   " << hit_full_reverse << "\n";
        std::cout << "hit_nearly_sorted:  " << hit_nearly_sorted << "\n";
        std::cout << "hit_all_equal:      " << hit_all_equal << "\n";
        std::cout << "hit_nan_handled:    " << hit_nan_handled << "\n";
        std::cout << "hit_heap_select:    " << count_heap_select << "\n";
        std::cout << "used_partial_sort:  " << used_partial_sort << "\n";
        std::cout << "used_radix_sort:    " << used_radix_sort << "\n";
        std::cout << "used_sort_network:  " << used_sort_network << "\n";
        std::cout << "used_block_partition: " << used_block_partition << "\n";
        std::cout << "used_run_merge:     " << used_run_merge << "\n";
        std::cout << "topk_truncated:     " << topk_truncated << "\n";
        std::cout << "bad_partitions:     " << count_bad_partitions << "\n";
        std::cout << "radix_sort_calls:   " << count_radix_sort << "\n";
        std::cout << "block_partitions:   " << count_block_partition << "\n";
        std::cout << "runs_detected:      " << count_runs_detected << "\n";
        std::cout << "partition count:    " << count_partition << "\n";
        std::cout << "insertion calls:    " << count_insertion << "\n";
        std::cout << "heap fallback:      " << count_heap_fallback << "\n";
        std::cout << "info: Ripple-Sort v2.1.1 Adaptive\n";
        std::cout << "------------------------------------\n";
    }
};

// ============================================================
// Sorting networks (libc++ inspired)
// ============================================================
template<typename T, typename Compare>
inline void _sort_network_3(T* data, Compare comp)
{
    auto cswap = [&](int i, int j) {
        if (comp(data[j], data[i])) std::swap(data[i], data[j]);
    };
    cswap(0, 2);
    cswap(0, 1);
    cswap(1, 2);
}

template<typename T, typename Compare>
inline void _sort_network_4(T* data, Compare comp)
{
    auto cswap = [&](int i, int j) {
        if (comp(data[j], data[i])) std::swap(data[i], data[j]);
    };
    cswap(0, 2);
    cswap(1, 3);
    cswap(0, 1);
    cswap(2, 3);
    cswap(1, 2);
}

template<typename T, typename Compare>
inline void _sort_network_5(T* data, Compare comp)
{
    auto cswap = [&](int i, int j) {
        if (comp(data[j], data[i])) std::swap(data[i], data[j]);
    };
    cswap(0, 2);
    cswap(1, 3);
    cswap(0, 1);
    cswap(2, 4);
    cswap(1, 2);
    cswap(3, 4);
    cswap(0, 1);
    cswap(2, 3);
    cswap(1, 2);
}

// ============================================================
// Unguarded insertion sort (libc++ inspired)
// ============================================================
template<typename T, typename Compare, bool Stats = false>
void _unguarded_insertion_sort(std::vector<T>& data, int low, int high, Compare comp, SortStats* st = nullptr)
{
    if constexpr (Stats) { if (st) st->count_insertion++; }
    for (int i = low + 1; i <= high; ++i) {
        T key = std::move(data[i]);
        int j = i - 1;
        while (comp(key, data[j])) {
            data[j + 1] = std::move(data[j]);
            --j;
        }
        data[j + 1] = std::move(key);
    }
}

// ============================================================
// Copy-free median_of_three
// ============================================================
template<typename T, typename Compare>
inline const T& median_of_three(const T& a, const T& b, const T& c, Compare comp)
{
    if (comp(b, a)) {
        if (comp(c, b)) return c;
        if (comp(c, a)) return a;
        return b;
    } else {
        if (comp(c, a)) return a;
        if (comp(c, b)) return c;
        return b;
    }
}

// ============================================================
// 32-bit radix sort (ska_sort inspired) with NaN handling
// ============================================================
template<typename T>
static inline unsigned int _to_unsigned_32(T x) {
    static_assert(std::is_same_v<T, int> || std::is_same_v<T, unsigned int> || std::is_same_v<T, float>,
                  "_to_unsigned_32 only supports 32-bit types (int, unsigned int, float)");
    if constexpr (std::is_same_v<T, int>) {
        return static_cast<unsigned int>(x) ^ (1u << 31);
    } else if constexpr (std::is_same_v<T, unsigned int>) {
        return x;
    } else if constexpr (std::is_same_v<T, float>) {
        static_assert(sizeof(float) == 4, "float must be 32-bit for radix sort");
        unsigned int u;
        std::memcpy(&u, &x, sizeof(float));
        if (std::isnan(x)) {
            return 0xFFFFFFFFu;
        }
        unsigned int sign_bit = static_cast<unsigned int>(-static_cast<int>(u >> 31));
        return u ^ (sign_bit | 0x80000000u);
    }
}

template<typename T>
static inline unsigned int _radix_byte_32(T x, int byte) {
    return (_to_unsigned_32(x) >> (byte * 8)) & 0xFF;
}

template<typename T>
bool _radix_sort_32(std::vector<T>& data, SortStats* st = nullptr)
{
    const int n = static_cast<int>(data.size());
    if (n <= 1) return true;
    if constexpr (!std::is_arithmetic_v<T>) return false;

    if constexpr (!(std::is_same_v<T, int> || std::is_same_v<T, unsigned int> || std::is_same_v<T, float>)) {
        return false;
    }

    std::vector<T> buffer(n);
    int count[256];
    int pos[256];

    for (int byte = 0; byte < 4; ++byte) {
        std::memset(count, 0, sizeof(count));
        for (int i = 0; i < n; ++i) {
            ++count[_radix_byte_32(data[i], byte)];
        }
        pos[0] = 0;
        for (int i = 1; i < 256; ++i) {
            pos[i] = pos[i - 1] + count[i - 1];
        }
        for (int i = 0; i < n; ++i) {
            int idx = _radix_byte_32(data[i], byte);
            buffer[pos[idx]++] = std::move(data[i]);
        }
        data.swap(buffer);
    }
    if (st) {
        st->used_radix_sort = true;
        st->count_radix_sort++;
    }
    return true;
}

// ============================================================
// 64-bit radix sort (ska_sort inspired) with NaN handling
// ============================================================
template<typename T>
static inline unsigned long long _to_unsigned_64(T x) {
    static_assert(std::is_same_v<T, long long> || std::is_same_v<T, unsigned long long> ||
                  std::is_same_v<T, double>,
                  "_to_unsigned_64 only supports 64-bit types (long long, unsigned long long, double)");
    if constexpr (std::is_same_v<T, long long>) {
        return static_cast<unsigned long long>(x) ^ (1ull << 63);
    } else if constexpr (std::is_same_v<T, unsigned long long>) {
        return x;
    } else if constexpr (std::is_same_v<T, double>) {
        static_assert(sizeof(double) == 8, "double must be 64-bit for radix sort");
        unsigned long long u;
        std::memcpy(&u, &x, sizeof(double));
        if (std::isnan(x)) {
            return 0xFFFFFFFFFFFFFFFFull;
        }
        unsigned long long sign_bit = static_cast<unsigned long long>(-static_cast<long long>(u >> 63));
        return u ^ (sign_bit | 0x8000000000000000ull);
    }
}

template<typename T>
static inline unsigned int _radix_byte_64(T x, int byte) {
    return (_to_unsigned_64(x) >> (byte * 8)) & 0xFF;
}

template<typename T>
bool _radix_sort_64(std::vector<T>& data, SortStats* st = nullptr)
{
    const int n = static_cast<int>(data.size());
    if (n <= 1) return true;
    if constexpr (!std::is_arithmetic_v<T>) return false;

    if constexpr (!(std::is_same_v<T, long long> || std::is_same_v<T, unsigned long long> ||
                    std::is_same_v<T, double>)) {
        return false;
    }

    std::vector<T> buffer(n);
    int count[256];
    int pos[256];

    for (int byte = 0; byte < 8; ++byte) {
        std::memset(count, 0, sizeof(count));
        for (int i = 0; i < n; ++i) {
            ++count[_radix_byte_64(data[i], byte)];
        }
        pos[0] = 0;
        for (int i = 1; i < 256; ++i) {
            pos[i] = pos[i - 1] + count[i - 1];
        }
        for (int i = 0; i < n; ++i) {
            int idx = _radix_byte_64(data[i], byte);
            buffer[pos[idx]++] = std::move(data[i]);
        }
        data.swap(buffer);
    }
    if (st) {
        st->used_radix_sort = true;
        st->count_radix_sort++;
    }
    return true;
}

// ============================================================
// Block Three-Way Partition (BlockQuicksort inspired)
// ============================================================
template<typename T, typename Compare>
struct BlockThreeWayPartition {
    static constexpr int BLOCK_SIZE = 64;
    int l_offsets[BLOCK_SIZE];
    int r_offsets[BLOCK_SIZE];
    int l_cnt, r_cnt;

    BlockThreeWayPartition() : l_cnt(0), r_cnt(0) {
        std::fill_n(l_offsets, BLOCK_SIZE, 0);
        std::fill_n(r_offsets, BLOCK_SIZE, 0);
    }

    void reset() { l_cnt = r_cnt = 0; }

    void flush_left(std::vector<T>& data, int& lt, int& i) {
        for (int k = 0; k < l_cnt; ++k) {
            std::swap(data[lt++], data[i]);
            i++;
        }
        l_cnt = 0;
    }

    void flush_right(std::vector<T>& data, int& gt, int& i) {
        for (int k = 0; k < r_cnt; ++k) {
            std::swap(data[i], data[gt--]);
        }
        r_cnt = 0;
    }

    void flush(std::vector<T>& data, int& lt, int& gt, int& i) {
        if (l_cnt > 0) flush_left(data, lt, i);
        if (r_cnt > 0) flush_right(data, gt, i);
    }
};

template<typename T, typename Compare, bool Stats = false>
void _block_three_way_partition(std::vector<T>& data, int low, int high, int& lt, int& gt, T pivot, Compare comp, SortStats* st = nullptr)
{
    const int n = high - low + 1;
    if (n < 128) {
        lt = low;
        int i = low;
        gt = high;
        while (i <= gt) {
            if (comp(data[i], pivot)) {
                std::swap(data[lt], data[i]);
                lt++;
                i++;
            } else if (comp(pivot, data[i])) {
                std::swap(data[i], data[gt]);
                gt--;
            } else {
                i++;
            }
        }
        return;
    }

    lt = low;
    int i = low;
    gt = high;
    BlockThreeWayPartition<T, Compare> block;

    while (i <= gt) {
        block.reset();
        const int remaining = gt - i + 1;
        const int batch = std::min(BlockThreeWayPartition<T, Compare>::BLOCK_SIZE, remaining);
        int j = i;

        for (int k = 0; k < batch; ++k, ++j) {
            if (comp(data[j], pivot)) {
                block.l_offsets[block.l_cnt++] = j - i;
            } else if (comp(pivot, data[j])) {
                block.r_offsets[block.r_cnt++] = j - i;
            }
        }

        if (block.l_cnt > 0 && block.r_cnt > 0) {
            int cnt = std::min(block.l_cnt, block.r_cnt);
            for (int k = 0; k < cnt; ++k) {
                std::swap(data[i + block.l_offsets[k]], data[i + block.r_offsets[k]]);
            }
            for (int k = 0; k < block.l_cnt; ++k) {
                std::swap(data[lt], data[i + block.l_offsets[k]]);
                lt++;
            }
            for (int k = 0; k < block.r_cnt; ++k) {
                std::swap(data[i + block.r_offsets[k]], data[gt]);
                gt--;
            }
            i += batch;
        } else if (block.l_cnt > 0) {
            for (int k = 0; k < block.l_cnt; ++k) {
                std::swap(data[lt], data[i + block.l_offsets[k]]);
                lt++;
            }
            i += block.l_cnt;
        } else if (block.r_cnt > 0) {
            for (int k = 0; k < block.r_cnt; ++k) {
                std::swap(data[i + block.r_offsets[k]], data[gt]);
                gt--;
            }
            i += block.r_cnt;
        } else {
            i += batch;
        }
    }

    if constexpr (Stats) {
        if (st) {
            st->used_block_partition = true;
            st->count_block_partition++;
        }
    }
}

// ============================================================
// Run detection (Timsort inspired, light version)
// ============================================================
struct Run {
    int start;
    int len;
    bool descending;
};

template<typename T, typename Compare>
std::vector<Run> _detect_runs(std::vector<T>& data, Compare comp)
{
    std::vector<Run> runs;
    const int n = static_cast<int>(data.size());
    if (n <= 1) return runs;

    int i = 0;
    while (i < n) {
        int start = i;
        if (i + 1 >= n) {
            runs.push_back({start, 1, false});
            break;
        }
        bool desc = comp(data[i + 1], data[i]);
        while (i + 1 < n && (comp(data[i + 1], data[i]) == desc ||
               (!comp(data[i], data[i + 1]) && !comp(data[i + 1], data[i])))) {
            i++;
        }
        int len = i - start + 1;
        if (desc) {
            std::reverse(data.begin() + start, data.begin() + i + 1);
        }
        runs.push_back({start, len, desc});
        i++;
    }
    return runs;
}

template<typename T, typename Compare>
void _merge_runs(std::vector<T>& data, const std::vector<Run>& runs, Compare comp, SortStats* st = nullptr)
{
    if (runs.size() <= 1) return;
    std::vector<Run> current = runs;
    while (current.size() > 1) {
        std::vector<Run> next;
        for (size_t i = 0; i < current.size(); i += 2) {
            if (i + 1 < current.size()) {
                const Run& left = current[i];
                const Run& right = current[i + 1];
                std::inplace_merge(data.begin() + left.start,
                                   data.begin() + left.start + left.len,
                                   data.begin() + left.start + left.len + right.len,
                                   comp);
                next.push_back({left.start, left.len + right.len, false});
            } else {
                next.push_back(current[i]);
            }
        }
        current = std::move(next);
    }
    if (st) st->used_run_merge = true;
}

// ============================================================
// Partial insertion sort with move limit (pdqsort inspired)
// ============================================================
template<typename T, typename Compare>
bool _partial_insertion_sort(std::vector<T>& data, int low, int high, Compare comp, int limit = PARTIAL_INSERTION_LIMIT)
{
    if (low >= high) return true;
    int moves = 0;
    for (int i = low + 1; i <= high; ++i) {
        T key = data[i];
        int j = i - 1;
        while (j >= low && comp(key, data[j])) {
            data[j + 1] = data[j];
            --j;
            if (++moves > limit) {
                return false;
            }
        }
        data[j + 1] = key;
    }
    return true;
}

// ============================================================
// Standard binary insertion sort
// ============================================================
template<typename T, typename Compare = std::less<T>, bool Stats = false>
void _insertion_sort(std::vector<T>& data, int low, int high, Compare comp, SortStats* st = nullptr)
{
    if constexpr (Stats) { if (st) st->count_insertion++; }

    for (int i = low + 1; i <= high; ++i)
    {
        T key = std::move(data[i]);
        int left = low, right = i;
        while (left < right)
        {
            int mid = left + (right - left) / 2;
            if (comp(key, data[mid]))
                right = mid;
            else
                left = mid + 1;
        }
        for (int j = i; j > left; --j)
            data[j] = std::move(data[j - 1]);
        data[left] = std::move(key);
    }
}

// ============================================================
// Heap sort helpers
// ============================================================
template<typename T, typename Compare = std::less<T>>
void _sift_down(std::vector<T>& data, int root, int end, int offset, Compare comp)
{
    T root_val = std::move(data[root]);
    while (true)
    {
        int child = (root - offset) * 2 + 1 + offset;
        if (child > end) break;
        if (child + 1 <= end && comp(data[child], data[child + 1]))
            child++;
        if (!comp(root_val, data[child]))
            break;
        data[root] = std::move(data[child]);
        root = child;
    }
    data[root] = std::move(root_val);
}

template<typename T, typename Compare = std::less<T>, bool Stats = false>
void _heap_sort(std::vector<T>& data, int low, int high, Compare comp, SortStats* st = nullptr)
{
    if constexpr (Stats) { if (st) st->count_heap_fallback++; }
    int n = high - low + 1;
    for (int start = low + n / 2 - 1; start >= low; --start)
        _sift_down(data, start, high, low, comp);
    for (int end = high; end > low; --end)
    {
        std::swap(data[low], data[end]);
        _sift_down(data, low, end - 1, low, comp);
    }
}

// ============================================================
// Core sorting engine
// ============================================================
struct Range {
    int low;
    int high;
    int depth;
    int bad_allowed;
};

template<typename T, typename Compare = std::less<T>, bool Stats = false>
static void _intro_sort_core(std::vector<T>& data, int k, Compare comp, SortStats* st)
{
    int n = static_cast<int>(data.size());
    if (n <= 1) return;

    bool topk_processed = false;

    // ============================================================
    // Fast path: radix sort (32-bit and 64-bit)
    // ============================================================
    if (k == -1 && n > RADIX_SORT_THRESHOLD && n < 10000000) {
        if constexpr (std::is_same_v<T, int> || std::is_same_v<T, unsigned int> || std::is_same_v<T, float>) {
            if (_radix_sort_32(data, st)) return;
        }
        if constexpr (std::is_same_v<T, long long> || std::is_same_v<T, unsigned long long> || std::is_same_v<T, double>) {
            if (_radix_sort_64(data, st)) return;
        }
    }

    // ============================================================
    // Pre-scan (Turbo prescreen)
    // ============================================================
    if (n >= PRESCAN_THRESHOLD && (k == -1 || k > 16))
    {
        // Detect all equal
        if (!comp(data[0], data[n - 1]) && !comp(data[n - 1], data[0]))
        {
            bool all_same = true;
            for (int i = 1; i < n; ++i)
            {
                if (comp(data[i], data[0]) || comp(data[0], data[i]))
                {
                    all_same = false;
                    break;
                }
            }
            if (all_same)
            {
                if constexpr (Stats) { if (st) st->hit_all_equal = true; }
                return;
            }
        }

        // Fast sorted detection
        bool sample_sorted = true;
        int sample_points[] = { 0, n / 4, n / 2, 3 * n / 4 };
        for (int i = 0; i < 3; ++i) {
            if (comp(data[sample_points[i + 1]], data[sample_points[i]])) {
                sample_sorted = false;
                break;
            }
        }
        if (sample_sorted) {
            bool full_sorted = true;
            for (int i = 0; i < n - 1; ++i) {
                if (comp(data[i + 1], data[i])) {
                    full_sorted = false;
                    break;
                }
            }
            if (full_sorted) {
                if constexpr (Stats) { if (st) st->hit_full_sorted = true; }
                return;
            }
        }

        // Three-probe inversion count
        int inv = 0;
        if (n >= 2 && comp(data[1], data[0])) ++inv;
        if (n >= 4 && comp(data[n / 2 + 1], data[n / 2])) ++inv;
        if (n >= 3 && comp(data[n - 1], data[n - 2])) ++inv;

        // Run detection for partially ordered data
        if (inv <= 2 && n > 256) {
            auto runs = _detect_runs(data, comp);
            if (runs.size() > 1 && runs.size() <= 4) {
                if constexpr (Stats) { if (st) st->count_runs_detected = runs.size(); }
                _merge_runs(data, runs, comp, st);
                if constexpr (Stats) { if (st) st->used_run_merge = true; }
                return;
            }
        }

        // Nearly sorted detection
        if (inv <= 1)
        {
            int inversions = 0;
            int sample_sz = std::min(NEARLY_SORTED_SAMPLE, n / 3);
            if (sample_sz > 0)
            {
                int seg_offsets[] = { 0, n / 2 - sample_sz / 2, n - sample_sz };
                for (int off : seg_offsets)
                {
                    int pos = off;
                    if (pos < 0) pos = 0;
                    if (pos + sample_sz > n) pos = n - sample_sz;
                    for (int i = pos; i < pos + sample_sz - 1 && i < n - 1; ++i)
                    {
                        if (comp(data[i + 1], data[i]))
                        {
                            if (++inversions >= MAX_NEARLY_SORTED_INVERSION)
                                break;
                        }
                    }
                    if (inversions >= MAX_NEARLY_SORTED_INVERSION)
                        break;
                }
            }
            if (inversions < MAX_NEARLY_SORTED_INVERSION)
            {
                if constexpr (Stats) { if (st) st->hit_nearly_sorted = true; }
                _insertion_sort<T, Compare, Stats>(data, 0, n - 1, comp, st);
                return;
            }
        }

        // Full reverse detection
        if (inv >= 3)
        {
            bool full_reverse = true;
            for (int i = 0; i < n - 1; ++i)
            {
                if (!comp(data[i + 1], data[i]))
                {
                    full_reverse = false;
                    break;
                }
            }
            if (full_reverse)
            {
                if constexpr (Stats) { if (st) st->hit_full_reverse = true; }
                std::reverse(data.begin(), data.end());
                return;
            }
        }
    }

    // ============================================================
    // Top-K handling with IntroSelect
    // ============================================================
    if (k != -1 && k > 0 && k <= n)
    {
        if (k == n) {
            // Full sort
        } else if (k <= n / 10 && n >= 100) {
            if constexpr (Stats) { if (st) st->count_heap_select++; }
            topk_processed = true;
            std::vector<T> heap(data.begin(), data.begin() + k);
            std::make_heap(heap.begin(), heap.end(), comp);
            for (int i = k; i < n; ++i) {
                if (comp(data[i], heap[0])) {
                    std::pop_heap(heap.begin(), heap.end(), comp);
                    heap.back() = data[i];
                    std::push_heap(heap.begin(), heap.end(), comp);
                }
            }
            for (int i = 0; i < k; ++i)
                data[i] = std::move(heap[i]);
            _insertion_sort<T, Compare, Stats>(data, 0, k - 1, comp, st);
            return;
        } else if (k <= n / 2) {
            if constexpr (Stats) { if (st) st->used_partial_sort = true; }
            topk_processed = true;
            std::partial_sort(data.begin(), data.begin() + k, data.end(), comp);
            return;
        } else {
            if constexpr (Stats) { if (st) st->topk_truncated = true; }
            std::nth_element(data.begin(), data.begin() + k, data.end(), comp);
            std::sort(data.begin(), data.begin() + k, comp);
            return;
        }
    }

    // ============================================================
    // Introsort main loop with Block Partition
    // ============================================================
    int max_depth = 0;
    while ((1LL << max_depth) < n) max_depth++;
    max_depth *= 2;

    std::vector<Range> stk;
    stk.reserve(max_depth + 16);
    int initial_bad_allowed = std::max(1, max_depth / 4);
    stk.push_back({ 0, n - 1, max_depth, initial_bad_allowed });

    while (!stk.empty())
    {
        Range r = stk.back();
        stk.pop_back();
        int low = r.low;
        int high = r.high;
        int depth = r.depth;
        int bad_allowed = r.bad_allowed;

        while (true)
        {
            int len = high - low + 1;

            if (len < INSERTION_SORT_THRESHOLD)
            {
                if (len <= SORT_NETWORK_THRESHOLD) {
                    if constexpr (Stats) { if (st) st->used_sort_network = true; }
                    switch (len) {
                        case 1: break;
                        case 2: if (comp(data[high], data[low])) std::swap(data[low], data[high]); break;
                        case 3: _sort_network_3(data.data() + low, comp); break;
                        case 4: _sort_network_4(data.data() + low, comp); break;
                        case 5: _sort_network_5(data.data() + low, comp); break;
                        default: _insertion_sort<T, Compare, Stats>(data, low, high, comp, st); break;
                    }
                } else if (low == 0) {
                    _insertion_sort<T, Compare, Stats>(data, low, high, comp, st);
                } else {
                    _unguarded_insertion_sort<T, Compare, Stats>(data, low, high, comp, st);
                }
                break;
            }

            if (depth == 0)
            {
                _heap_sort<T, Compare, Stats>(data, low, high, comp, st);
                break;
            }

            int mid = low + (high - low) / 2;
            T pivot;
            if (len >= NINTHER_THRESHOLD)
            {
                const T& m1 = median_of_three(data[low], data[low + 1], data[low + 2], comp);
                const T& m2 = median_of_three(data[mid - 1], data[mid], data[mid + 1], comp);
                const T& m3 = median_of_three(data[high - 2], data[high - 1], data[high], comp);
                pivot = median_of_three(m1, m2, m3, comp);
            }
            else
            {
                if (comp(data[mid], data[low])) std::swap(data[mid], data[low]);
                if (comp(data[high], data[low])) std::swap(data[high], data[low]);
                if (comp(data[high], data[mid])) std::swap(data[high], data[mid]);
                pivot = std::move(data[mid]);
            }

            // NaN safety: if pivot is NaN, handle specially
            if constexpr (std::is_floating_point_v<T>) {
                if (std::isnan(pivot)) {
                    int nan_count = 0;
                    for (int i = low; i <= high; ++i) {
                        if (std::isnan(data[i])) {
                            std::swap(data[i], data[high - nan_count]);
                            nan_count++;
                        }
                    }
                    if (nan_count > 0 && st) st->hit_nan_handled = true;
                    high -= nan_count;
                    if (low >= high) break;
                    continue;
                }
            }

            if constexpr (Stats) { if (st) st->count_partition++; }

            // Use Block Three-Way Partition for large arrays
            int lt, gt;
            if (len > 256) {
                _block_three_way_partition<T, Compare, Stats>(data, low, high, lt, gt, pivot, comp, st);
            } else {
                lt = low;
                int i = low;
                gt = high;
                while (i <= gt) {
                    if (comp(data[i], pivot)) {
                        std::swap(data[lt], data[i]);
                        lt++;
                        i++;
                    } else if (comp(pivot, data[i])) {
                        std::swap(data[i], data[gt]);
                        gt--;
                    } else {
                        i++;
                    }
                }
            }

            int l_size = lt - low;
            int r_size = high - gt;
            bool highly_unbalanced = (l_size < len / 8 || r_size < len / 8);

            if (highly_unbalanced)
            {
                if constexpr (Stats) { if (st) st->count_bad_partitions++; }
                if (--bad_allowed == 0) {
                    _heap_sort<T, Compare, Stats>(data, low, high, comp, st);
                    break;
                }

                if (l_size >= 4) {
                    std::swap(data[low], data[low + l_size / 4]);
                    std::swap(data[lt - 1], data[lt - 1 - l_size / 4]);
                }
                if (r_size >= 4) {
                    std::swap(data[gt + 1], data[gt + 1 + r_size / 4]);
                    std::swap(data[high], data[high - r_size / 4]);
                }
            }
            else
            {
                if (l_size <= 16 && r_size <= 16) {
                    bool left_ok = _partial_insertion_sort(data, low, lt - 1, comp);
                    bool right_ok = _partial_insertion_sort(data, gt + 1, high, comp);
                    if (left_ok && right_ok) {
                        if constexpr (Stats) { if (st) st->used_partial_sort = true; }
                        break;
                    }
                }
            }

            if (l_size < r_size)
            {
                if (gt + 1 <= high)
                    stk.push_back({ gt + 1, high, depth - 1, bad_allowed });
                high = lt - 1;
            }
            else
            {
                if (low <= lt - 1)
                    stk.push_back({ low, lt - 1, depth - 1, bad_allowed });
                low = gt + 1;
            }
            depth--;
        }
    }

    if (k != -1 && k > 0 && k <= n && !topk_processed && k <= n / 2)
    {
        _insertion_sort<T, Compare, Stats>(data, 0, k - 1, comp, st);
    }
}

// ============================================================
// Public interfaces
// ============================================================
template<typename T, typename Compare = std::less<T>>
std::vector<T> intro_sort(const std::vector<T>& arr, Compare comp = {})
{
    std::vector<T> data = arr;
    _intro_sort_core<T, Compare, false>(data, -1, comp, nullptr);
    return data;
}

template<typename T, typename Compare = std::less<T>>
std::vector<T> intro_sort_debug(const std::vector<T>& arr, SortStats& out_stats, Compare comp = {})
{
    std::vector<T> data = arr;
    out_stats = {};
    _intro_sort_core<T, Compare, true>(data, -1, comp, &out_stats);
    return data;
}

template<typename T, typename Compare = std::less<T>>
std::vector<T> intro_sort_topk(const std::vector<T>& arr, int k, Compare comp = {})
{
    std::vector<T> data = arr;
    if (k <= 0) return data;
    int n = static_cast<int>(data.size());
    if (k > n) k = n;
    _intro_sort_core<T, Compare, false>(data, k, comp, nullptr);
    return data;
}

template<typename T, typename Compare = std::less<T>>
std::vector<T> intro_sort_topk_debug(const std::vector<T>& arr, int k, SortStats& out_stats, Compare comp = {})
{
    std::vector<T> data = arr;
    if (k <= 0) return data;
    int n = static_cast<int>(data.size());
    if (k > n) k = n;
    out_stats = {};
    _intro_sort_core<T, Compare, true>(data, k, comp, &out_stats);
    return data;
}

// ============================================================
// In-place sort (zero copy)
// ============================================================
template<typename T, typename Compare = std::less<T>>
void intro_sort_inplace(std::vector<T>& data, Compare comp = {})
{
    _intro_sort_core<T, Compare, false>(data, -1, comp, nullptr);
}

template<typename T, typename Compare = std::less<T>>
void intro_sort_inplace_debug(std::vector<T>& data, SortStats& out_stats, Compare comp = {})
{
    out_stats = {};
    _intro_sort_core<T, Compare, true>(data, -1, comp, &out_stats);
}

// ============================================================
// Command-line interface
// ============================================================
std::vector<int> parse_numbers(const std::string& line)
{
    std::vector<int> res;
    std::istringstream iss(line);
    while (iss)
    {
        int ch = iss.peek();
        if (ch == EOF) break;
        if (ch == '-' || std::isdigit(static_cast<unsigned char>(ch)))
        {
            int x;
            if (iss >> x)
                res.push_back(x);
        }
        else
        {
            iss.ignore();
        }
    }
    return res;
}

static void print_help()
{
    std::cout << "\n\n===== Ripple-Sort  " << VERSION << " =====\n";
    std::cout << "  <numbers...>          ascending sort\n";
    std::cout << "  r <numbers...>        descending sort\n";
    std::cout << "  topk N <numbers>      get top-k smallest (ascending)\n";
    std::cout << "  r topk N <numbers>    get top-k largest (descending)\n";
    std::cout << "  help                  show this help\n";
    std::cout << "  quit                  exit program\n";
    std::cout << "\nNotes:\n";
    std::cout << "  - topk only guarantees the first k elements are sorted.\n";
    std::cout << "  - Use ASCII hyphen '-' for negative numbers.\n";
    std::cout << "  - topk strategy: heap select (k <= n/10), partial_sort (n/10 < k <= n/2), nth_element + sort (k > n/2)\n";
    std::cout << "  - Detailed statistics are automatically shown when sorting 128 or more elements.\n";
    std::cout << "====================================\n";
}

int main()
{
    // ===== 启动界面：只保留一个换行，没有多余空行 =====
    std::cout << "\n=================================================\n";
    std::cout << "        Ripple-Sort Tool  " << VERSION << "\n";
    std::cout << "        Status: Ripple-Sort startup success\n";
    std::cout << "=================================================\n";
    std::cout << "type help for command list\n";

    std::string line;
    while (true)
    {
        std::cout << "\n>> ";
        if (!std::getline(std::cin, line)) break;
        if (line.empty()) continue;

        std::istringstream cmd(line);
        std::string first;
        cmd >> first;

        bool descending = false;

        if (first == "r")
        {
            descending = true;
            if (!(cmd >> first))
            {
                std::cout << "\nr needs numbers after it\n";
                continue;
            }
        }

        if (first == "quit")
        {
            break;
        }
        else if (first == "help")
        {
            print_help();
        }
        else if (first == "topk")
        {
            int k;
            if (!(cmd >> k))
            {
                std::cout << "\nusage: topk N numbers\n";
                continue;
            }
            if (k <= 0)
            {
                std::cout << "\nk must be > 0\n";
                continue;
            }

            std::string rest;
            std::getline(cmd, rest);
            auto nums = parse_numbers(rest);

            if (nums.empty())
            {
                std::cout << "\nno valid numbers for topk\n";
                continue;
            }

            if (k > (int)nums.size())
            {
                std::cout << "\nwarning: k(" << k << ") > size(" << nums.size()
                          << "), adjusted to " << nums.size() << "\n";
                k = (int)nums.size();
            }

            auto t0 = std::chrono::high_resolution_clock::now();
            SortStats st;

            std::vector<int> out;
            if (descending)
            {
                out = intro_sort_topk_debug(nums, k, st, std::greater<int>());
                std::cout << "\n\n[Top-K (descending) k=" << k << "] result: ";
            }
            else
            {
                out = intro_sort_topk_debug(nums, k, st);
                std::cout << "\n\n[Top-K (ascending) k=" << k << "] result: ";
            }

            auto t1 = std::chrono::high_resolution_clock::now();
            double ms = std::chrono::duration<double, std::milli>(t1 - t0).count();

            int printCount = std::min(k, (int)out.size());
            for (int i = 0; i < printCount; ++i)
                std::cout << out[i] << " ";
            std::cout << "\n\ntime: " << ms << " ms\n";

            // 仅当数据量 >= 128 时打印统计面板
            if ((int)nums.size() >= 128) {
                st.print();
            }
        }
        else
        {
            auto nums = parse_numbers(line);
            if (nums.empty())
            {
                std::cout << "\nno valid numbers\n";
                continue;
            }

            auto t0 = std::chrono::high_resolution_clock::now();
            SortStats st;

            std::vector<int> out;
            if (descending)
            {
                out = intro_sort_debug(nums, st, std::greater<int>());
                std::cout << "\n\n[Full sort (descending)] result: ";
            }
            else
            {
                out = intro_sort_debug(nums, st);
                std::cout << "\n\n[Full sort (ascending)] result: ";
            }

            auto t1 = std::chrono::high_resolution_clock::now();
            double ms = std::chrono::duration<double, std::milli>(t1 - t0).count();

            for (auto v : out) std::cout << v << " ";
            std::cout << "\n\ntime: " << ms << " ms\n";

            if ((int)nums.size() >= 128) {
                st.print();
            }
        }
    }

    std::cout << "\n\nRipple-Sort terminated.\n";
    return 0;
}
